# Copy to .env.local. Values below are public Firebase web-app configuration.
# Existing project defaults are retained in src/APIS/config.js for compatibility.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Optional HTTPS server endpoint. Leave blank to show the unconfigured assistant.
# POST {"question":"..."}, Authorization: Bearer <Firebase ID token>
# Response: {"answer":"..."}. Keep provider API keys on the server only.
REACT_APP_AI_ENDPOINT=
